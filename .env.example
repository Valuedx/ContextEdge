# ContextEdge Environment Configuration

# ── Database ──
DATABASE_URL=postgresql+asyncpg://contextedge:contextedge@localhost:5432/contextedge
DATABASE_URL_SYNC=postgresql://contextedge:contextedge@localhost:5432/contextedge
POSTGRES_USER=contextedge
POSTGRES_PASSWORD=contextedge
POSTGRES_DB=contextedge

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO (S3-compatible object storage) ──
MINIO_ROOT_USER=contextedge
MINIO_ROOT_PASSWORD=contextedge-secret
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=contextedge-evidence
MINIO_USE_SSL=false

# ── Auth / JWT ──
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional JSON map for X-Service-Token -> tenant_id, user_id, email, roles, optional allowed_domain_ids
# allowed_domain_ids: list of domain UUID strings; omit for full-tenant access; [] = tenant-wide playbooks only
# Example: {"svc-dev-token":{"tenant_id":"...","user_id":"...","email":"svc@local","roles":["service_account"],"allowed_domain_ids":["..."]}}
SERVICE_TOKENS_JSON={}

# ── Encryption (Fernet key for credential storage) ──
FERNET_KEY=change-me-generate-with-cryptography-fernet-generate-key

# ── AI / LLM ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_CLASSIFICATION_MODEL=gpt-4o-mini
DEFAULT_EXTRACTION_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ── Connector Credentials (per-source, managed via UI) ──
# MS Teams / Graph API
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

# Gmail / Google Workspace
GOOGLE_SERVICE_ACCOUNT_JSON=

# ServiceNow
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Jira Service Management
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Application ──
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
