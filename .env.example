# ContextEdge — environment template
#
# Copy to .env at the repo root and fill in. Settings are read from
# <repo>/.env first, then backend/.env (see backend/src/contextedge/config.py).
# Every key below has a default in that file; only the ones marked REQUIRED
# have no usable default.
#
# Never commit a filled-in .env — it holds signing keys and provider
# credentials. .env is gitignored; this template is the shared reference.

# ── Database ───────────────────────────────────────────────────────────
# Needs PostgreSQL with pgvector. The compose stack publishes it on 5433;
# a native install without pgvector on 5432 will fail on vector columns.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/contextedge
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/contextedge
# Consumed by docker-compose when it creates the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contextedge

# ── Redis (cache + Celery) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO (evidence object store) ──────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=contextedge
MINIO_ROOT_PASSWORD=contextedge-secret
MINIO_BUCKET=contextedge-evidence
MINIO_USE_SSL=false

# ── Auth ───────────────────────────────────────────────────────────────
# REQUIRED outside development: startup refuses to boot on the default.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Service accounts for machine callers, as JSON keyed by token string:
#   {"tok_abc": {"tenant_id": "<uuid>", "user_id": "<uuid>",
#                "email": "svc@example.com", "roles": ["service_account"]}}
SERVICE_TOKENS_JSON={}

# ── Encryption ─────────────────────────────────────────────────────────
# REQUIRED outside development. Encrypts stored source credentials — if this
# key changes, existing ciphertext is unrecoverable, so set it once and keep
# it safe.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── LLM provider ───────────────────────────────────────────────────────
# The provider is chosen by the LiteLLM prefix on each model id below. Set
# the models and the matching credential. DEFAULT_LLM_PROVIDER matters in one
# case only: when it is "vertex_ai" and credentials are set, bare "gemini-*"
# ids (no prefix) are routed through Vertex (ai/provider._is_vertex_model).
#
#   OpenAI     gpt-4o-mini              + OPENAI_API_KEY
#   Anthropic  claude-...               + ANTHROPIC_API_KEY
#   Gemini     gemini/gemini-2.5-flash  + GOOGLE_API_KEY
#   Vertex AI  vertex_ai/gemini-2.5-flash + GOOGLE_APPLICATION_CREDENTIALS
DEFAULT_LLM_PROVIDER=openai

# ── Per-Task Model & Location Routing ──────────────────────────────────
# Each pipeline phase can target a different model AND a different Vertex AI
# region independently. Change *_LOCATION to route a task to a specific
# regional endpoint (e.g. us-central1, europe-west1, global).

# Relevance Filter
DEFAULT_CLASSIFICATION_MODEL=gpt-4o-mini
CLASSIFICATION_LOCATION=global

# Normalization & Extraction
DEFAULT_EXTRACTION_MODEL=gpt-4o
EXTRACTION_LOCATION=global

# Pattern Discovery — 2.5-flash until this lane gets its own A/B
PATTERN_MODEL=vertex_ai/gemini-2.5-flash
PATTERN_LOCATION=global

# Playbook Generation — 3.7-flash won the 2026-08-17 A/B
# (evals/playbook_model_ab.py: grounding 0.70 -> 0.81, latency halved)
PLAYBOOK_MODEL=vertex_ai/gemini-3.7-flash
PLAYBOOK_LOCATION=global

# Embeddings — must return 3072 dimensions. text-embedding-3-small returns
# 1536 and will raise; use text-embedding-3-large or vertex_ai/gemini-embedding-001.
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_LOCATION=global

# Global fallback location (used when a task has no per-task location set)
LOCATION=global

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_API_KEY=

# Google Cloud project ID for Vertex AI
GOOGLE_CLOUD_PROJECT=

# Vertex AI: absolute path to a service-account JSON. ai/provider.py exports
# this plus VERTEX_LOCATION for LiteLLM at import time.
GOOGLE_APPLICATION_CREDENTIALS=

# Retry a failed call once on this model, recording usage against whichever
# model actually served. Leave blank to disable.
LLM_FALLBACK_MODEL=

# ── Cost containment ───────────────────────────────────────────────────
# Ceilings, not targets — ordinary work stays well under all of them. The
# defaults below are the shipped values; uncomment only to override.
#
# Retries multiply the worst-case cost of every call, since each one is
# billed in full.
# LLM_NUM_RETRIES=2
# Hard ceiling on generated tokens per call, applied over the caller's value.
# LLM_MAX_OUTPUT_TOKENS=4096
# Per-task overrides of that ceiling, for tasks whose correct answer is
# genuinely longer than the default (JSON map, task name -> tokens).
# LLM_TASK_OUTPUT_TOKENS={"playbook": 16384, "extraction": 16384, "pattern": 16384}
# Per-prompt thinking budgets (JSON map, prompt name -> reasoning-token cap).
# Ships with exactly one entry; every other prompt keeps dynamic thinking.
# Do NOT add prompts without the A/B discipline in
# codewiki/18-cost-observability-and-containment.md - a cap that changes
# output structure is a quality change, not a cost change.
# LLM_THINKING_BUDGETS={"relevance": 0}
# Resolution gate for episode synthesis: "cluster" defers reconstruction for
# clusters carrying no resolution signal anywhere (deferred, not dropped — the
# next correlate->reconstruct dispatch re-checks once new evidence joins the
# cluster). It is a cluster-level check, never an evidence filter: in
# scattered-source deployments the problem and the fix arrive from different
# systems, and dropping problem-side evidence would break correlation.
# EPISODE_RESOLUTION_GATE=off
# AI first-pass review of pending episode drafts: "advisory" stamps a verdict
# on each draft for the human queue; "auto_approve" additionally approves the
# subset clearing both the model verdict AND the deterministic floors
# (episode_review_service). Auto-approvals keep reviewer_user_id NULL, so they
# stay permanently distinguishable from human approvals.
# EPISODE_AI_REVIEW=off
# Vision-model description of document figures during artifact extraction.
# DOCUMENT_VISION_ENABLED=false
# Largest number of texts per embedding request; longer lists are split.
# EMBEDDING_MAX_BATCH_SIZE=64
# Daily caps for tenants with no tenant_llm_budgets row. Without these, an
# unconfigured tenant — the normal state — is the only uncapped one. Blank
# both to restore unlimited.
# DEFAULT_DAILY_TOKEN_LIMIT=2000000
# DEFAULT_DAILY_COST_CAP_USD=25.0
# block raises TenantBudgetExceeded so callers can degrade; warn logs and
# lets the call through. Roll out as warn, then flip to block.
# DEFAULT_BUDGET_ACTION_ON_EXCEED=block

# ── Application ────────────────────────────────────────────────────────
# app_env anything other than "development" enforces the JWT and Fernet
# checks above at startup.
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Ingest safety ──────────────────────────────────────────────────────
# Redacts PII and secrets before embedding and LLM extraction, so raw
# payloads never leave the tenant boundary. Turn off only for local debugging.
# REDACTION_ENABLED=true

# ── Retention ──────────────────────────────────────────────────────────
# soft_purge scrubs content in place; hard_delete removes rows and cascades.
# RETENTION_PURGE_MODE=soft_purge
# RETENTION_DEFAULT_DAYS=365

# ── Notifications (no-ops until configured) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFICATION_WEBHOOK_URL=

# ── Connectors (optional) ──────────────────────────────────────────────
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

# Zoho Desk. Scopes are fixed when the refresh token is issued, so adding
# one later means re-issuing the token: Desk.tickets.READ for tickets,
# Desk.articles.READ for the knowledge base, Desk.settings.READ for
# per-department discovery. A partial grant syncs what it can and reports
# the rest (see codewiki/ZOHO_DESK_CONNECTOR.md).
ZOHO_DESK_CLIENT_ID=
ZOHO_DESK_CLIENT_SECRET=
ZOHO_DESK_REFRESH_TOKEN=
ZOHO_DESK_ORG_ID=
# Must match the portal's data center — accounts and API hosts are a pair
# and a cross-DC call fails auth. One of: com in eu au jp ca sa uk
ZOHO_DESK_DATA_CENTER=com

# ── Prompt A/B (optional) ──────────────────────────────────────────────
# Per-tenant prompt version overrides:
#   {"<tenant-uuid>": {"relevance": "v2", "episode": "v3"}}
# TENANT_PROMPT_VARIANTS_JSON={}
