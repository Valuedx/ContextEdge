# ── Cost containment ───────────────────────────────────────────────────
# All four have safe defaults in config.py; uncomment only to override.
# Retries multiply the worst-case cost of every call (was hardcoded 5).
# LLM_NUM_RETRIES=2
# Hard ceiling on generated tokens per call, applied over the caller's value.
# LLM_MAX_OUTPUT_TOKENS=4096
# Largest number of texts per embedding request; bigger lists are split.
# EMBEDDING_MAX_BATCH_SIZE=64
# Caps for tenants with no tenant_llm_budgets row. Before these existed, an
# unconfigured tenant was the only uncapped one. Blank/None restores that.
# DEFAULT_DAILY_TOKEN_LIMIT=2000000
# DEFAULT_DAILY_COST_CAP_USD=25.0
# DEFAULT_BUDGET_ACTION_ON_EXCEED=block

